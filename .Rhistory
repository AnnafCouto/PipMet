sort(pslist[[i]]@spectrum[, 1], decreasing = TRUE)
for (ii in 1:6) {
crom <- chromatogram(raw_data, rt = c(rt[[i]] - 8, rt[[i]] + 8), mz = c(as.numeric(f[[ii]]) - 0.6, as.numeric(f[[ii]]) + 0.6))
