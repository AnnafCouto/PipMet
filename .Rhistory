# Função para verificar chunks
check_chunks <- function(rmd_file) {
lines <- readLines(rmd_file, warn = FALSE)
# Detecta linhas de início de chunk
chunk_lines <- grep("^```\\{r", lines)
if(length(chunk_lines) == 0) {
message(rmd_file, ": ❌ Não possui chunks de código R")
return(FALSE)
}
# Verifica se eval = FALSE aparece em algum chunk
eval_false <- grep("eval\\s*=\\s*FALSE", lines[chunk_lines])
if(length(eval_false) > 0) {
message(rmd_file, ": ⚠️ Alguns chunks têm eval=FALSE")
} else {
message(rmd_file, ": ✅ Todos os chunks são avaliados")
}
return(TRUE)
}
# Checa todos os .Rmd
lapply(rmd_files, check_chunks)
