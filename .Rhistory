for (i in 1:length(pslist)) {
x <- data.frame(cbind(pslist[[i]]@spectrum[, 1], (pslist[[i]]@spectrum[, 2] / max(pslist[[i]]@spectrum[, 2])))) # standardazing intensities by dividing the intensity of each peak from a spectrum by the maximum intensity of that spectra.
colnames(x) <- c("mz", "into")
spectra[[i]] <- x
}
result <- metaMS::construct.msp(spectra, extra.info = NULL)
for (i in 1:length(result)) {
result[[i]]$id <- pslist[[i]]@id
result[[i]]$rt <- pslist[[i]]@rt
result[[i]]$Name <- paste0("Unknown ", pslist[[i]]@id)
result[[i]]$Date <- as.character(Sys.Date())
}
RI <- read.csv(RI)
result <- addRI (result, RI)
metaMS::write.msp(result, "spectra.msp", newFile = TRUE)
}
pslist <- PipMet::extractSpectra(anIC, min_peaks = 5) # justificar número de picos mínimos
writeFeaturelist(pslist, "pre_anno.csv")
#
# function to prepare the extracted spectra to be written in .msp file
library(metaMS)
create_spectra(pslist, '~/Abreu/RI_fiehn.csv')
pre_anno <- read.csv("pre_anno.csv", sep = ",", na.string = c("NA", ""))
peaktable <- matrix(nrow = nrow(pre_anno), ncol = 4 + nrow(metadata))
colnames(peaktable) <- c("id", "Name", "rt", "mz", metadata$sample)
peaktable[, "id"] <- as.numeric(pre_anno[, "id"])
peaktable[, "Name"] <- pre_anno[, "annotation"]
peaktable[, "rt"] <- pre_anno [, "rt"]
sample_col <- paste0('X', 1:nrow(metadata))
for (i in 1:length(pslist)) {
ion_mass <- pslist[[i]]@spectrum[which(pslist[[i]]@spectrum [,2] == max(pslist[[i]]@spectrum[,2])),1][1]
peaktable[i, "mz"] <- ion_mass
ion_id <- which (anIC@groupInfo[anIC@pspectra[pslist[[i]]@id][[1]], 'mz'] == ion_mass)
spec <- anIC@groupInfo[anIC@pspectra[pslist[[i]]@id][[1]], sample_col]
if (length(ion_id)>1) {
peaktable[i, metadata$sample] <- apply(spec [ion_id,], 2, sum)
} else {peaktable[i, metadata$sample] <- spec [ion_id,]}
}
write.csv(peaktable, "PeakTable_splitless.csv", row.names = FALSE, na = "")
mat <- peaktable [,c(5:(4+nrow(metadata)))]
mat[mat == 0] <- NA
mat[mat > 0 & mat < 1] <- 0
mat <- apply(mat, 2, as.numeric)
# normalization with CyclicLoess method
mat <- performCyclicLoessNormalization(mat)
peaktable <- cbind(peaktable [, c(1:4)], mat)
write.csv(peaktable, 'Normalized_quantification.csv', row.names = FALSE)
save.image('splitless_script_velho.RData')
q()
