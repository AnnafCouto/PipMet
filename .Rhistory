library(PipMet)
rm(raw_data, colors)
View(metadata)
library(MSnbase)
library(xcms)
library(CAMERA)
library(CluMSID)
library(metaMS)
library(NormalyzerDE)
library(BiocParallel)
register(SerialParam(), default = TRUE)
setwd('~/Abreu')
xs <- xcmsSet(metadata$file, method = "matchedFilter", fwhm = 5,snthresh = 2, step= 0.1, steps= 2,sigma = 3.56718192627824, max= 500, mzdiff= 1,index= FALSE,phenoData = metadata,sclass = metadata$group, snames = metadata$sample, polarity = 'positive', BPPARAM = BiocParallel::SerialParam())
xs2 <- group(xs,method = "density", bw=0.5, mzwid= 1, minfrac = 0.3, minsamp = 1,max = 500)
xset2 <- retcor(xs2)
xset3 <- group(xset2,method = "density", bw=0.5, mzwid= 1, minfrac = 0.3, minsamp = 1,max = 500)
xset<-fillPeaks(xset3)
# the spectra is proposed using both retention time window and group correlation information
# comparar número de pseudospectros antes e depois do groupCorr
register(SnowParam(), default = TRUE)
an<-xsAnnotate(xset, polarity = 'positive')
anF<-groupFWHM(an, perfwhm=1)
# Created
anIC <- groupCorr(anF, calcIso = FALSE)
save.image('less_script_velho.RData')
